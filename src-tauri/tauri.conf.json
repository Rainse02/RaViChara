{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "../static",
    "distDir": "../static"
  },
  "package": {
    "productName": "RaViChara",
    "version": "0.6.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "category": "Social",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "externalBin": [],
      "icon": [],
      "identifier": "com.ravichara.desktop",
      "longDescription": "RaViChara desktop virtual character application",
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": ""
      },
      "resources": [],
      "shortDescription": "RaViChara Desktop",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "RaViChara — 虚拟角色陪伴",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": true
      }
    ]
  }
}
